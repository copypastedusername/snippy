{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: its commands, the app version, and the custom title bar (drag, minimise, close; maximise is deliberately not granted).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-get-config",
    "allow-set-config",
    "allow-reset-config",
    "allow-pick-output-directory",
    "allow-start-snip",
    "allow-recent-captures",
    "allow-open-path",
    "allow-reveal-path",
    "allow-open-output-dir",
    "allow-copy-capture",
    "allow-delete-capture",
    "allow-pause-shortcuts",
    "allow-resume-shortcuts",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-is-elevated",
    "allow-open-default-apps",
    "allow-preview-sound",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-windows-shortcut-status",
    "allow-open-keyboard-settings",
    "allow-main-ready",
    "allow-open-editor"
  ]
}
