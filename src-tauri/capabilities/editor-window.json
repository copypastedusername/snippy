{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor-window",
  "description": "The editor: its own image, text recognition and export, and showing itself once its first frame is painted.",
  "windows": [
    "editor"
  ],
  "permissions": [
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-editor-info",
    "allow-editor-pixels",
    "allow-editor-unsaved",
    "allow-editor-ocr",
    "allow-ocr-languages",
    "allow-editor-export"
  ]
}
